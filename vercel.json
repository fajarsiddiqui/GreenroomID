{
  "cleanUrls": true,
  "installCommand": "dnf install -y nspr nss nss-util libdrm mesa-libgbm && npm install",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "greenroom-id.vercel.app"
        }
      ],
      "destination": "https://www.greenroomid.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/shop",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://otyugnwavbhkzbponbez.supabase.co; connect-src 'self' https://otyugnwavbhkzbponbez.supabase.co wss://otyugnwavbhkzbponbez.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/shop/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://otyugnwavbhkzbponbez.supabase.co; connect-src 'self' https://otyugnwavbhkzbponbez.supabase.co wss://otyugnwavbhkzbponbez.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/kritik-saran",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/akses-totp",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/akses-totp/publik",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/akses-totp/greenroomid",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/akses-totp/kode",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/dashboard",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/profile",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/admin",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/admin/:path*",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/client",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/client/:path*",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/request",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/request/:path*",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/f/:slug",
      "destination": "/__spa-fallback"
    }
  ]
}
