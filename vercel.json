{
  "cleanUrls": true,
  "installCommand": "dnf install -y nspr nss nss-util libdrm mesa-libgbm && npm install",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "greenroom-id.vercel.app"
        }
      ],
      "destination": "https://www.greenroomid.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/__spa-fallback"
    }
  ]
}
