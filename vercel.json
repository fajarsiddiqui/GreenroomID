{
  "cleanUrls": true,
  "installCommand": "dnf install -y nspr nss nss-util libdrm mesa-libgbm && npm install",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "greenroom-id.vercel.app"
        }
      ],
      "destination": "https://www.greenroomid.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/layanan-gratis",
      "destination": "/404",
      "statusCode": 404
    },
    {
      "source": "/layanan-gratis/:path*",
      "destination": "/404",
      "statusCode": 404
    },
    {
      "source": "/tools",
      "destination": "/404",
      "statusCode": 404
    },
    {
      "source": "/tools/:path*",
      "destination": "/404",
      "statusCode": 404
    },
    {
      "source": "/login",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/kritik-saran",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/dashboard",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/profile",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/ruang-belajar/saya",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/ruang-belajar/tulis",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/admin",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/admin/:path*",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/client",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/client/:path*",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/request",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/request/:path*",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/ruang-belajar/pembayaran",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/ruang-belajar/pembayaran/:path*",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/studio-artikel/saya",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/studio-artikel/tulis",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/studio-artikel/pembayaran",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/studio-artikel/pembayaran/:path*",
      "destination": "/__spa-fallback"
    },
    {
      "source": "/f/:slug",
      "destination": "/__spa-fallback"
    }
  ]
}
